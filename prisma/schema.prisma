datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "ACCOUNTANT", "QUALITY_CONTROLLER", "ADMIN", or custom "WEAVING_SUPERVISOR"
  label       String   // e.g. "Accountant", "Quality Controller", "Weaving Supervisor"
  department  String?  // e.g. "Accounts & Payroll", "Floor & Quality Control"
  description String?
  canSignup   Boolean  @default(true) // Whether users can choose this role during signup
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@map("roles")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  roleKey      String     @default("ACCOUNTANT") // Role key (e.g. "admin", "accountant", "quality_controller")
  roleId       String?
  role         Role?      @relation(fields: [roleId], references: [id])
  department   String?
  status       UserStatus @default(PENDING)
  isActive     Boolean    @default(true)
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}
