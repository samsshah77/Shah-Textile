datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  POST
  EXPORT
  ASSIGN
  MANAGE
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum PermissionScope {
  ALL
  OWN
  DEPARTMENT
  ASSIGNED
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "ACCOUNTANT", "QUALITY_CONTROLLER", "ADMIN", or custom "WEAVING_SUPERVISOR"
  label       String   // e.g. "Accountant", "Quality Controller", "Weaving Supervisor"
  department  String?  // e.g. "Accounts & Payroll", "Floor & Quality Control"
  description String?
  canSignup   Boolean  @default(true) // Whether users can choose this role during signup
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  rolePermissions  RolePermission[]
  roleModuleGrants RoleModuleGrant[]

  @@map("roles")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  roleKey      String     @default("accountant") // admin | accountant | quality_controller
  roleId       String?
  role         Role?      @relation(fields: [roleId], references: [id])
  department   String?
  status       UserStatus @default(PENDING)
  isActive     Boolean    @default(true)
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userPermissions UserPermission[]

  @@map("users")
}

model Module {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resources        Resource[]
  roleModuleGrants RoleModuleGrant[]

  @@map("modules")
}

model Resource {
  id          String  @id @default(uuid())
  moduleId    String
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  key         String
  label       String
  description String?
  sensitive   Boolean @default(false)

  permissions Permission[]

  @@unique([moduleId, key])
  @@map("resources")
}

model Permission {
  id         String           @id @default(uuid())
  resourceId String
  resource   Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  action     PermissionAction

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([resourceId, action])
  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(uuid())
  roleId       String
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       PermissionEffect @default(ALLOW)
  scope        PermissionScope  @default(ALL)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       PermissionEffect @default(ALLOW)
  scope        PermissionScope  @default(ALL)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model RoleModuleGrant {
  id       String           @id @default(uuid())
  roleId   String
  role     Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleId String
  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  action   PermissionAction
  effect   PermissionEffect @default(ALLOW)
  scope    PermissionScope  @default(ALL)

  @@unique([roleId, moduleId, action])
  @@map("role_module_grants")
}

model PermissionAuditLog {
  id           String            @id @default(uuid())
  actorUserId  String
  roleId       String?
  permissionId String?
  moduleKey    String
  resourceKey  String?
  action       PermissionAction
  effect       PermissionEffect?
  scope        PermissionScope?
  operation    String
  metadata     Json?
  createdAt    DateTime          @default(now())

  @@map("permission_audit_logs")
}

model LoginThrottle {
  fingerprint     String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("login_throttles")
}

// ==========================================
// FLOOR PRODUCTION (UI masters → PostgreSQL)
// Local vs live use separate DATABASE_URL hosts.
// ==========================================

model FloorLoom {
  loomNumber      Int      @id
  name            String
  model           String
  category        String   @default("G6200")
  year            Int?
  pictureDataUrl  String?  @db.Text
  pictureDataUrls Json     @default("[]")
  defaultRpm      Int      @default(340)
  shed            String?  @default("Main Floor")
  isActive        Boolean  @default(true)
  status          String   @default("RUNNING")
  statusSince     String?
  qualityAssignedOn String?
  qualityId       String?
  weftYarnId      String?
  isTwinBeam      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("floor_looms")
}

model FloorBeam {
  beamNo         String   @id
  warp           String   @default("")
  reed           Int      @default(60)
  width          Float    @default(66)
  totalThreads   Int      @default(0)
  length         Float    @default(0)
  loomType       String   @default("G6200")
  fillStatus     String   @default("FULL") // EMPTY | FULL
  usedInLoom     String?
  location       String?  @default("STORE") // STORE | SIZING | loom#
  mountedOn      String?
  beamEndedOn    String?
  endedFromLoom  String?
  /** Linked Quality master (warp recipe) — optional. */
  qualityId      String?
  /** Sw# lot — Daily Entry “SW #” column; same quality name, different run id (Excel). */
  swLot          String?
  /** Optional beam repeat label/value — empty allowed. */
  beamRepeat     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("floor_beams")
}

model FloorYarn {
  id          String   @id
  yarnType    String
  bags        Int      @default(0)
  receivedKg  Float    @default(0)
  issuedKg    Float    @default(0)
  balanceKg   Float    @default(0)
  receivedLbs Float    @default(0)
  issuedLbs   Float    @default(0)
  balanceLbs  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("floor_yarns")
}

model FloorYarnMovement {
  id           String   @id
  type         String // INWARD | OUTWARD
  yarnId       String
  yarnType     String
  date         String // YYYY-MM-DD
  weightKg     Float   @default(0)
  weightLbs    Float   @default(0)
  bags         Int?
  loomNumber   Int?
  pick         Int?
  lotOrSupplier String?
  createdAt    String
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@index([yarnId])
  @@map("floor_yarn_movements")
}

model FloorYarnIssuance {
  id         String   @id
  yarnId     String
  yarnType   String
  loomNumber Int
  issuedKg   Float    @default(0)
  pick       Int      @default(0)
  date       String
  createdAt  String
  updatedAt  DateTime @updatedAt

  @@index([date])
  @@index([yarnId])
  @@map("floor_yarn_issuances")
}

model FloorQuality {
  id         String   @id
  name       String
  fabricType String   @default("Suiting")
  weavePlan  String   @default("")
  weftPlan   String   @default("")
  warpYarn   String   @default("")
  weftYarn   String   @default("")
  reed       Int      @default(120)
  pick       Int      @default(60)
  widthInch  Float    @default(66)
  gsm        Float    @default(0)
  status     String   @default("ACTIVE")
  createdOn  String?
  endedOn    String?
  specHistory Json    @default("[]")
  yarnHistory Json    @default("[]")
  loomEnds    Json    @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("floor_qualities")
}

/** Sheet entry per loom per day per segment (segment 1 = primary; 2+ = same-day dual quality). */
model FloorDailySheet {
  id           String   @id @default(uuid())
  date         String // YYYY-MM-DD
  loomNumber   Int
  segmentIndex Int      @default(1)
  payload      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([date, loomNumber, segmentIndex])
  @@index([date])
  @@map("floor_daily_sheets")
}

/** Legacy / unused by UI — kept for auth-era schema compatibility if already pushed. */
model Loom {
  id            Int               @id @default(autoincrement())
  loomNumber    Int               @unique
  model         String
  category      String            @default("G6200")
  defaultRpm    Int               @default(340)
  shed          String?           @default("Main Floor")
  isActive      Boolean           @default(true)
  currentStatus String            @default("RUNNING")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  productions   DailyProduction[]
  beams         BeamStock[]

  @@map("looms")
}

model FabricQuality {
  id           String            @id @default(uuid())
  qualityName  String            @unique
  fabricType   String
  warpYarn     String
  weftYarn     String
  reed         Int
  pick         Int
  widthInch    Float
  gsm          Float?
  ratePerPick  Float             @default(0.95)
  targetMeters Float             @default(10000)
  lot          String?
  warpRepeat   String?
  weftRepeat   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  productions  DailyProduction[]

  @@map("fabric_qualities")
}

model BeamStock {
  id            String   @id @default(uuid())
  beamNo        String   @unique
  warpYarn      String
  reedWidth     String
  ends          Int
  lengthMeters  Float
  loomType      String
  status        String   @default("IN_STOCK")
  mountedLoomId Int?
  mountedLoom   Loom?    @relation(fields: [mountedLoomId], references: [loomNumber])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("beam_stocks")
}

model DailyProduction {
  id                   String         @id @default(uuid())
  date                 DateTime       @db.Date
  loomNumber           Int
  loom                 Loom           @relation(fields: [loomNumber], references: [loomNumber])
  qualityId            String?
  quality              FabricQuality? @relation(fields: [qualityId], references: [id])
  shiftAMeters         Float          @default(0)
  shiftBMeters         Float          @default(0)
  totalMeters          Float          @default(0)
  rollerHours          Int            @default(24)
  runningHours         Float          @default(24)
  rpm                  Int            @default(340)
  pick                 Int            @default(60)
  theoreticalMeters    Float          @default(0)
  efficiencyPercentage Float          @default(0)
  stopLossMeters       Float          @default(0)
  status               String         @default("RUNNING")
  remarks              String?
  lot                  String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([date, loomNumber])
  @@map("daily_productions")
}

model WeftStockRecord {
  id                 String   @id @default(uuid())
  date               DateTime @db.Date
  yarnType           String
  quantityKg         Float    @default(0)
  issuedToLoomNumber Int?
  balanceKg          Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("weft_stock_records")
}

model YarnStock {
  id             String   @id @default(uuid())
  yarnType       String   @unique
  fiberBlend     String?  @default("Polyester Viscose")
  lotNumber      String?
  totalBags      Int      @default(0)
  receivedKg     Float    @default(0)
  issuedKg       Float    @default(0)
  balanceKg      Float    @default(0)
  unitPriceKg    Float?   @default(650)
  minThresholdKg Float?   @default(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("yarn_stocks")
}

model PayrollStore {
  key       String   @id
  payload   Json
  updatedAt DateTime @updatedAt

  @@map("payroll_store")
}

model AccountsStore {
  key       String   @id
  payload   Json
  updatedAt DateTime @updatedAt

  @@map("accounts_store")
}


/// Append-only change history (who changed what, when, old → new).
/// Created at runtime by src/server/auditLog.ts (CREATE TABLE IF NOT EXISTS), so live
/// servers get it without running `prisma db push`.
model AuditLog {
  id        String   @id
  createdAt DateTime @default(now())
  actorId   String?
  actorName String?
  actorRole String?
  module    String
  action    String
  entityKey String
  entityId  String?
  changes   Json?
  meta      Json?
  ip        String?

  @@index([createdAt])
  @@index([module, entityKey])
  @@map("audit_logs")
}
